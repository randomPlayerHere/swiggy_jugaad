# Copy to .env and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-...
TELEGRAM_BOT_TOKEN=

# Swiggy MCP bearer token. Get it with: uv run scripts/swiggy_login.py
# OAuth 2.1 + PKCE, ~5 day lifetime, no refresh — re-run the script when it dies.
SWIGGY_ACCESS_TOKEN=

# Demo: have sync_orders replay sample orders instead of Swiggy's ~15-day
# history. Only the order fetch changes; addresses/search/cart/checkout stay live.
# SWIGGY_ORDERS_REPLAY=data/demo_orders.json

# SWIGGY_JUGAAD_DB=data/swiggy_jugaad.db
# SWIGGY_OAUTH_CALLBACK_PORT=3030
